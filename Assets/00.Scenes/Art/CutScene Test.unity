  cuts:
  - image: {fileID: 21300000, guid: 0c451ce81e0b18b4eae54e44d18461ad, type: 3}
    text: "21XX\uB144, \uAC70\uB300\uD55C \uB208\uBCF4\uB77C\uAC00 \uC138\uC0C1\uC744
      \uB4A4\uC5CE\uC5C8\uB2E4.\n..\uADF8\uB9AC\uACE0 \uC778\uB958\uB294 5\uB144\uB9CC\uC5D0
      \uBA78\uC885\uD558\uC600\uB2E4."
    fadeDuration: 1
    isPanEffect: 0
    panOffset: {x: 0, y: 800}
  - image: {fileID: 21300000, guid: 742545619750471469a8a1158cfe2209, type: 3}
    text: "\uBD88\uD589\uD788\uB3C4 \uB098\uB294 \uADF8 \uC911 \uC720\uC77C\uD788
      \uC0B4\uC544\uB0A8\uC740 \uC778\uAC04\uC774\uB2E4."
    fadeDuration: 1
    isPanEffect: 0
    panOffset: {x: 0, y: 800}
  - image: {fileID: 21300000, guid: bbfe7772b446cbb419cadfed96cfbdb1, type: 3}
    text: "\uC774\uB7F0 \uD639\uB3C5\uD55C \uD658\uACBD\uC18D\uC5D0\uC11C\uB3C4 \uB048\uC9C8\uAE30\uAC8C
      \uC0B4\uC544\uB0A8\uC740."
    fadeDuration: 1
    isPanEffect: 0
    panOffset: {x: 0, y: 800}
  - image: {fileID: 21300000, guid: 6c8a6e7a9760fa242b0220011ac5a08f, type: 3}
    text: "\uC0B4\uC744 \uBE44\uC9D1\uACE0 \uB4E4\uC5B4\uC624\uB294 \uCD94\uC704\uC5D0
      \n\uC801\uB9C9\uD55C \uACE0\uB3C5\uB9CC\uC774 \uB9C8\uC74C\uC5D0 \uC2A4\uBA70\uB4E4\uC5C8\uB2E4. "
    fadeDuration: 1
    isPanEffect: 1
    panOffset: {x: 0, y: 800}
  - image: {fileID: 21300000, guid: 78043ab7a8866194caa100ddf27b35bf, type: 3}
    text: "\uC5F0\uAD6C\uD588\uB358 \uC815\uBCF4\uC5D0 \uC758\uD558\uBA74, \n\uC774
      \uBAA8\uB4E0 \uC77C\uC758 \uC6D0\uD749\uC740 \u2018\uC5BC\uC5B4\uBD99\uC740
      \uC2EC\uC7A5\u2019 \uC774\uC5C8\uB2E4."
    fadeDuration: 1
    isPanEffect: 0
    panOffset: {x: 0, y: 800}
  - image: {fileID: 21300000, guid: 368b28840b6b52f43a0c699456f8f526, type: 3}
    text: "\uADF8\uB9AC\uACE0 \uB9C8\uCE68\uB0B4 \uB098\uB294 \uC2EC\uC7A5\uC774
      \uC704\uCE58\uD55C\uB2E4\uB294 \n\u2018\uC138\uC0C1\uC758 \uC911\uC2EC\u2019\uC5D0
      \uB3C4\uB2EC\uD588\uB2E4."
    fadeDuration: 1
    isPanEffect: 0
    panOffset: {x: 0, y: 800}
  - image: {fileID: 21300000, guid: 296069014c13ad546b9314f682613ba0, type: 3}
    text: "\uC138\uC0C1\uC744 \uAD6C\uD558\uAE30 \uC704\uD574, \n\uADF8\uB9AC\uACE0
      \uC5BC\uC5B4\uBD99\uC740 \uB9C8\uC74C\uC744 \uB179\uC774\uAE30 \uC704\uD574."
    fadeDuration: 1
    isPanEffect: 0
    panOffset: {x: 0, y: 800}
  - image: {fileID: 21300000, guid: f53a1868380b92f4bb4267705152d279, type: 3}
